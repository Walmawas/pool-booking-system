{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "src/**",
      "package.json",
      "package-lock.json",
      "vite.config.js",
      "tailwind.config.js",
      "postcss.config.js"
    ],
    "headers": [
      {
        "source": "main.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600,stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "style.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600,stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=86400,stale-while-revalidate=604800"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
